# Database (Neon Postgres with pgvector)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Set to "true" to bypass login entirely and use a single local "dev user".
# Useful while the app isn't deployed / has no real users yet.
AUTH_DISABLED=true

# Auth.js v5 — GitHub + Google OAuth (not required while AUTH_DISABLED=true)
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Voyage AI — embeddings (voyage-large-2)
VOYAGE_API_KEY=

# Anthropic — Claude for chat/RAG
ANTHROPIC_API_KEY=

# Resend — weekly digest email
RESEND_API_KEY=

# Shared secret for POST /api/cron/digest (Vercel Cron)
DIGEST_CRON_SECRET=
